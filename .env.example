# ── delivery ─────────────────────────────────────────────────────────────────
# Telegram bot token from @BotFather. The bot must be an admin of the channel.
BOT_TOKEN=
# @channelname, or a numeric chat id for groups and private chats.
CHANNEL=

# ── what counts as a splash ──────────────────────────────────────────────────
# Move size that triggers an alert, %. Measured as the spread between the high
# and the low of the window.
THRESHOLD_PCT=12
# How far back the sliding window looks, minutes. Shorter = faster and noisier.
WINDOW_MIN=60
# How much further the price must go before the SAME direction alerts again.
# Defaults to THRESHOLD_PCT: a 12% pump alerts again only after another 12% on
# top of the alert price, not 12% from where the move started.
RETRIGGER_PCT=
# Ignore markets whose 24h volume is below this, $. Filters out dead listings.
MIN_VOL_24H=1000
# Tickers to skip entirely, comma-separated and without the quote suffix,
# e.g. BTC,ETH,SOL. Empty = watch everything.
BLACKLIST=

# ── misc ─────────────────────────────────────────────────────────────────────
# Hours added to UTC in the timestamp line of the alert.
TZ_OFFSET=0
# 1 = print alerts to the log instead of sending them to Telegram.
DRY_RUN=0
