# Copy to /etc/systemd/system/, adjust the paths, then:
#   systemctl daemon-reload && systemctl enable --now lighter-splash
[Unit]
Description=Lighter price-splash alerts
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/lighter-splash
ExecStart=/opt/lighter-splash/venv/bin/python -u /opt/lighter-splash/splash.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
